# Copia este archivo a .env y completa los valores

# Base de datos
POSTGRES_USER=admin
POSTGRES_PASSWORD=cambiar_en_produccion
POSTGRES_DB=restaurant_pos

# Backend
# Mínimo 32 caracteres (la app no arranca sin ella). Generar: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar_por_una_clave_segura_de_64_caracteres
# Orígenes permitidos por CORS, separados por coma. Con el proxy de nginx (mismo origen) no se usa,
# pero se mantiene por si el frontend se sirve desde otro origen.
CORS_ORIGINS=http://TU_IP_O_DOMINIO
DATABASE_URL=postgresql://admin:cambiar_en_produccion@db:5432/restaurant_pos

# Frontend: dejar vacío en producción (nginx hace proxy de /api al backend, mismo origen).
# Solo definir si el backend está en otro origen.
VITE_API_URL=
