# Copia este archivo a .env.local (desarrollo) y completa lo que necesites.

# URL del backend en desarrollo (vacío = mismo origen)
VITE_API_URL=http://localhost:8000

# Datos del emisor que se imprimen en el comprobante (todos opcionales; solo se imprime lo que pongas).
# Son variables de BUILD de Vite: tras cambiarlas hay que reconstruir el frontend.
# Sin VITE_EMISOR_NOMBRE se usa "Orbezo Resto Bar". No hay RUC ni dirección por defecto.
VITE_EMISOR_NOMBRE=
VITE_EMISOR_RUC=
VITE_EMISOR_DIRECCION=
VITE_EMISOR_TELEFONO=
# Ruta o URL de un logo (p. ej. /logo.png con el archivo en frontend_react/public/). Vacío = sin logo.
VITE_EMISOR_LOGO=
# Línea discreta al pie del comprobante (p. ej. "Documento interno"). Vacía por defecto: el sistema
# no envía a SUNAT y no imprime ninguna afirmación fiscal.
VITE_COMPROBANTE_LEYENDA=
